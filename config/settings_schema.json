[
  {
    "name": "theme_info",
    "theme_name": "Lashlume",
    "theme_version": "1.0.0",
    "theme_author": "Lashlume",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual"
  },
  {
    "name": "Kleuren",
    "settings": [
      { "type": "color", "id": "color_background", "label": "Achtergrond", "default": "#FFFFFF" },
      { "type": "color", "id": "color_surface", "label": "Vlakken (secties, kaarten)", "default": "#F7F7F7" },
      { "type": "color", "id": "color_text", "label": "Tekst", "default": "#111111" },
      { "type": "color", "id": "color_muted", "label": "Subtiele tekst", "default": "#6B6B6B" },
      { "type": "color", "id": "color_accent", "label": "Accent (knoppen)", "default": "#111111" },
      { "type": "color", "id": "color_accent_text", "label": "Tekst op knoppen", "default": "#FFFFFF" },
      { "type": "color", "id": "color_border", "label": "Randen", "default": "#E9E9E9" },
      { "type": "color", "id": "color_sale", "label": "Korting en prijs in de aanbieding", "default": "#D32F4B" },
      { "type": "color", "id": "color_badge", "label": "Label (bijv. laatste stuks)", "default": "#7A4A32" },
      { "type": "color", "id": "color_success", "label": "Op voorraad (groen)", "default": "#2E7D32" }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      { "type": "font_picker", "id": "type_header_font", "label": "Titels", "default": "dm_sans_n7" },
      { "type": "font_picker", "id": "type_body_font", "label": "Tekst", "default": "dm_sans_n4" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Paginabreedte", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1280 },
      { "type": "range", "id": "button_radius", "label": "Afronding knoppen", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 40 },
      { "type": "range", "id": "card_radius", "label": "Afronding kaarten en afbeeldingen", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 24 }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Wordt verkleind tot 64 x 64 px" }
    ]
  },
  {
    "name": "Winkelwagen",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Bedrag voor gratis levering (€)",
        "info": "Toont een voortgangsbalk in de winkelwagen. Zet op 0 om uit te schakelen.",
        "default": 0
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram-link", "placeholder": "https://instagram.com/lashlume" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok-link", "placeholder": "https://tiktok.com/@lashlume" },
      { "type": "text", "id": "social_facebook", "label": "Facebook-link" }
    ]
  }
]
