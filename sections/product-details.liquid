<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="details__heading">
        {%- assign hl = section.settings.highlight | escape -%}
        {%- if hl != blank -%}
          {{ section.settings.heading | escape | replace: hl, '[[M]]' | replace: '[[M]]', hl | prepend: '' | replace: hl, '<span class="mark">[[H]]</span>' | replace: '[[H]]', hl }}
        {%- else -%}
          {{ section.settings.heading | escape }}
        {%- endif -%}
      </h2>
    {%- endif -%}
    <div class="details">
      {%- for block in section.blocks -%}
        <details class="details__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>
            {% render 'icon', icon: block.settings.icon %}
            <span>{{ block.settings.title | escape }}</span>
            {% render 'icon', icon: 'plus' %}
          </summary>
          <div class="details__content rte">{{ block.settings.content }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productdetails",
  "class": "section-product-details",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Perfect tot in de details" },
    { "type": "text", "id": "highlight", "label": "Woord met cirkel", "info": "Moet precies in de titel voorkomen (hoofdlettergevoelig).", "default": "details" },
    { "type": "checkbox", "id": "open_first", "label": "Eerste blok open", "default": true }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Uitklapblok",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          { "value": "trophy", "label": "Beker" }, { "value": "clipboard", "label": "Specificaties" }, { "value": "palette", "label": "Materialen" },
          { "value": "users", "label": "Personalisatie" }, { "value": "info", "label": "Info" }, { "value": "shield", "label": "Garantie" },
          { "value": "truck", "label": "Levering" }, { "value": "box", "label": "Pakket" }
        ], "default": "trophy" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Waarom uniek?" },
        { "type": "richtext", "id": "content", "label": "Inhoud", "default": "<p>Beschrijf hier het product.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "Productdetails", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] }
  ]
}
{% endschema %}
