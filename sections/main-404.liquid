<section class="not-found">
  <div class="container">
    <span class="eyebrow">404</span>
    <h1>{{ 'not_found.title' | t }}</h1>
    <p class="muted">{{ 'not_found.text' | t }}</p>
    <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "class": "section-main-404",
  "settings": []
}
{% endschema %}
