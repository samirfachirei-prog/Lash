<section class="section">
  <div class="container">
    <article class="article">
      <p class="muted">{{ article.published_at | date: format: 'date' }}</p>
      <h1>{{ article.title | escape }}</h1>
      {%- if article.image -%}
        <div class="article__image">
          {{
            article.image
            | image_url: width: 1600
            | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: article.title
          }}
        </div>
      {%- endif -%}
      <div class="rte">{{ article.content }}</div>
      <p style="margin-top: 3rem;"><a class="link-arrow" href="{{ blog.url }}">&larr; {{ 'blogs.back' | t }}</a></p>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "Blogartikel",
  "class": "section-main-article",
  "settings": []
}
{% endschema %}
