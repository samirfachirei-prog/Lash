<section class="section">
  <div class="icon-row">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <ul class="icon-row__list" style="--cols: {{ section.blocks.size | at_least: 1 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="icon-row__item" {{ block.shopify_attributes }}>
          <span class="icon-row__circle">{% render 'icon', icon: block.settings.icon %}</span>
          <span>{{ block.settings.label | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Wat kun je verwachten",
  "class": "section-icon-row",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Wat zit er in de levering?" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Onderdeel",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          { "value": "bed", "label": "Bed" }, { "value": "book", "label": "Handleiding" }, { "value": "document", "label": "Garantiekaart" },
          { "value": "box", "label": "Pakket" }, { "value": "shield", "label": "Garantie" }, { "value": "truck", "label": "Levering" }, { "value": "sparkle", "label": "Beauty" }
        ], "default": "bed" },
        { "type": "text", "id": "label", "label": "Tekst", "default": "Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Wat kun je verwachten", "blocks": [
      { "type": "item", "settings": { "icon": "bed", "label": "Lash bed" } },
      { "type": "item", "settings": { "icon": "book", "label": "Handleiding" } },
      { "type": "item", "settings": { "icon": "document", "label": "Garantiekaart" } }
    ] }
  ]
}
{% endschema %}
