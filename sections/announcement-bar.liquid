{%- if section.settings.text != blank -%}
  <div
    class="announcement"
    style="background: {{ section.settings.color_bg }}; color: {{ section.settings.color_text }};"
  >
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
    {%- else -%}
      {{ section.settings.text | escape }}
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Aankondiging",
  "class": "section-announcement",
  "settings": [
    { "type": "text", "id": "text", "label": "Tekst", "default": "Levering in België en Nederland · Professionele lash studio inrichting" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color", "id": "color_bg", "label": "Achtergrond", "default": "#111111" },
    { "type": "color", "id": "color_text", "label": "Tekstkleur", "default": "#FFFFFF" }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
