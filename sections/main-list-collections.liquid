<div class="collection-hero container">
  <h1>
    {%- if section.settings.heading != blank -%}
      {{ section.settings.heading | escape }}
    {%- else -%}
      {{ 'collections.all_collections' | t }}
    {%- endif -%}
  </h1>
</div>
<section class="section section--tight">
  <div class="container">
    <div class="grid grid--4">
      {%- for col in collections -%}
        <a class="collection-tile" href="{{ col.url }}">
          {%- if col.featured_image != blank -%}
            {{
              col.featured_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                widths: '300, 450, 600, 900',
                sizes: '(min-width: 990px) 25vw, 50vw',
                alt: col.title
            }}
          {%- else -%}
            {%- assign ph = forloop.index | modulo: 4 | plus: 1 -%}
            {%- assign ph_name = 'collection-' | append: ph -%}
            {{ ph_name | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="collection-tile__label">
            {{ col.title | escape }}
            {% render 'icon', icon: 'arrow' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Alle collecties",
  "class": "section-main-list-collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Alle categorieën" }
  ]
}
{% endschema %}
