{%- liquid
  assign threshold_cents = settings.free_shipping_threshold | times: 100
-%}
<section class="section section--tight">
  <div class="container">
    <h1 class="text-center">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" data-cart-form novalidate>
        <div>
          {%- for item in cart.items -%}
            <div class="cart-item">
              <a href="{{ item.url }}" class="cart-item__image">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <div class="cart-item__meta">{{ item.variant.title | escape }}</div>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- assign first_char = property.first | slice: 0 -%}
                  {%- if property.last != blank and first_char != '_' -%}
                    <div class="cart-item__meta">{{ property.first | escape }}: {{ property.last | escape }}</div>
                  {%- endif -%}
                {%- endfor -%}
                <div class="cart-item__meta">{{ item.final_price | money }}</div>
                <div class="cart-item__actions">
                  <div class="qty">
                    <button type="button" data-qty-change="-1" aria-label="-">&minus;</button>
                    <label class="visually-hidden" for="Qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}</label>
                    <input
                      id="Qty-{{ forloop.index }}"
                      type="number"
                      name="updates[]"
                      value="{{ item.quantity }}"
                      min="0"
                      data-cart-qty
                    >
                    <button type="button" data-qty-change="1" aria-label="+">+</button>
                  </div>
                  <a class="cart-item__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div><strong>{{ item.final_line_price | money }}</strong></div>
            </div>
          {%- endfor -%}

          {%- if section.settings.show_note -%}
            <div class="field" style="margin-top: 1.5rem;">
              <label for="CartNote">{{ 'cart.note' | t }}</label>
              <textarea id="CartNote" class="input" name="note">{{ cart.note }}</textarea>
            </div>
          {%- endif -%}
          <noscript><button type="submit" class="btn btn--outline" name="update">{{ 'cart.update' | t }}</button></noscript>
        </div>

        <aside class="cart-summary">
          {%- if threshold_cents > 0 -%}
            {%- liquid
              assign remaining = threshold_cents | minus: cart.total_price
              assign progress = cart.total_price | times: 100 | divided_by: threshold_cents | at_most: 100
              assign remaining_money = remaining | money
            -%}
            <div class="free-ship">
              {%- if remaining > 0 -%}
                {{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}
              {%- else -%}
                {{ 'cart.free_shipping_reached' | t }}
              {%- endif -%}
              <div class="free-ship__bar"><span style="width: {{ progress }}%;"></span></div>
            </div>
          {%- endif -%}
          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money_with_currency }}</span>
          </div>
          <p class="muted" style="font-size: .9rem;">{{ 'cart.taxes_note' | t }}</p>
          <button type="submit" name="checkout" class="btn btn--full">{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}
            <div style="margin-top: .75rem;">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </aside>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p class="muted">{{ 'cart.empty' | t }}</p>
        <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Winkelwagen",
  "class": "section-main-cart",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Opmerkingenveld tonen", "default": true }
  ]
}
{% endschema %}
