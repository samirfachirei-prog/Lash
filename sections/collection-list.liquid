<section class="section">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
        <a class="link-arrow" href="{{ routes.collections_url }}">{{ 'collections.all_collections' | t }}</a>
      </div>
    {%- endif -%}
    <div class="grid grid--{{ section.blocks.size | at_most: 4 | at_least: 2 }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign tile_image = block.settings.image
          if tile_image == blank and col != blank
            assign tile_image = col.featured_image
          endif
          assign tile_title = block.settings.title
          if tile_title == blank and col != blank
            assign tile_title = col.title
          endif
          assign tile_url = routes.collections_url
          if col != blank
            assign tile_url = col.url
          endif
        -%}
        <a class="collection-tile" href="{{ tile_url }}" {{ block.shopify_attributes }}>
          <span class="collection-tile__media">
            {%- if tile_image != blank -%}
              {{
                tile_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 25vw, 50vw',
                  alt: tile_title
              }}
            {%- else -%}
              {%- assign ph = forloop.index | modulo: 4 | plus: 1 -%}
              {%- assign ph_name = 'collection-' | append: ph -%}
              {{ ph_name | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="collection-tile__label">
            {{ tile_title | escape }}
            {% render 'icon', icon: 'arrow' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categorieën",
  "class": "section-collection-list",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine titel", "default": "Studio inrichting" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Shop per categorie" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collectie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "title", "label": "Titel (optioneel)" },
        { "type": "image_picker", "id": "image", "label": "Afbeelding (optioneel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categorieën",
      "blocks": [
        { "type": "collection", "settings": { "title": "Lash beds" } },
        { "type": "collection", "settings": { "title": "Zadelstoelen" } },
        { "type": "collection", "settings": { "title": "Lampen" } },
        { "type": "collection", "settings": { "title": "Spiegels & statieven" } }
      ]
    }
  ]
}
{% endschema %}
