{%- assign current_year = 'now' | date: '%Y' -%}
<footer class="footer">
  <div class="container">
    <div class="footer__grid" style="--footer-cols: {{ section.blocks.size | at_least: 1 }};">
      <div>
        <a href="{{ routes.root_url }}" class="footer__brand">{{ shop.name }}</a>
        {%- if section.settings.text != blank -%}
          <div class="footer__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- liquid
          assign has_social = false
          if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_facebook != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <div class="socials" aria-label="{{ 'general.follow_us' | t }}">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon', icon: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon', icon: 'tiktok' %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon', icon: 'facebook' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'menu' -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <ul>
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}
                <h3>{{ block.settings.heading | escape }}</h3>
              {%- endif -%}
              {%- form 'customer', id: 'FooterNewsletter' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                {%- if form.posted_successfully? -%}
                  <p>{{ 'newsletter.success' | t }}</p>
                {%- else -%}
                  <div class="newsletter__form">
                    <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
                    <input id="FooterNewsletterEmail" class="input" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}">
                    <button class="btn" type="submit">{{ 'newsletter.subscribe' | t }}</button>
                  </div>
                {%- endif -%}
              {%- endform -%}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>{{ 'general.copyright' | t: year: current_year, shop: shop.name }}</span>
      {%- if section.settings.show_payment_icons -%}
        <ul class="payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Tekst onder de naam",
      "default": "<p>Professionele inrichting voor lash studio's: lash beds, zadelstoelen, lampen en meer.</p>"
    },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Betaalmethodes tonen", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>info@lashlume.eu</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Nieuwsbrief",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Nieuwsbrief" }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
