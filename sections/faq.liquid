<section class="section{% if section.settings.style == 'light' and section.settings.surface %} section--surface{% endif %}">
  {%- if section.settings.style == 'dark' -%}<div class="faq-dark">{%- else -%}<div class="container">{%- endif -%}
    <div class="section-header{% if section.settings.style == 'light' %} section-header--center{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank and section.settings.style == 'light' -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    </div>
    <div class="faq">
      {%- if section.settings.intro != blank -%}
        <p class="faq__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
      {%- for block in section.blocks -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}{% render 'icon', icon: 'plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Veelgestelde vragen",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine titel", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Veelgestelde vragen" },
    { "type": "select", "id": "style", "label": "Stijl", "options": [ { "value": "dark", "label": "Donker blok" }, { "value": "light", "label": "Licht" } ], "default": "dark" },
    { "type": "text", "id": "intro", "label": "Korte intro (optioneel)", "default": "" },
    { "type": "checkbox", "id": "surface", "label": "Gekleurde achtergrond (alleen bij Licht)", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "question", "label": "Vraag", "default": "Vraag" },
        { "type": "richtext", "id": "answer", "label": "Antwoord", "default": "<p>Antwoord</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Veelgestelde vragen",
      "blocks": [
        { "type": "question", "settings": { "question": "Naar welke landen leveren jullie?", "answer": "<p>We leveren in België en Nederland.</p>" } },
        { "type": "question", "settings": { "question": "Hoe lang duurt de levering van een lash bed?", "answer": "<p>Vul hier je levertijd in, bijvoorbeeld het aantal werkdagen voor grote pakketten.</p>" } },
        { "type": "question", "settings": { "question": "Kan ik als salon op factuur bestellen?", "answer": "<p>Leg hier uit hoe bedrijven met een btw-nummer kunnen bestellen.</p>" } },
        { "type": "question", "settings": { "question": "Kan ik een product retourneren?", "answer": "<p>Beschrijf hier je retourbeleid.</p>" } }
      ]
    }
  ]
}
{% endschema %}
