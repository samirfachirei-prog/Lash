{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign featured_media_id = current_variant.featured_media.id | default: product.featured_media.id
-%}

<script type="application/json" id="ProductVariants-{{ section.id }}">
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "available": {{ v.available | json }},
        "price": {{ v.price | money | json }},
        "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
        "media": {% if v.featured_media %}{{ v.featured_media.id | json }}{% else %}null{% endif %},
        "save": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price }}{% else %}0{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<section class="section section--tight">
  <div class="container product">
    <div class="product__media" data-gallery="{{ section.id }}">
      <div class="gallery__main">
        <button type="button" class="gallery__expand" data-gallery-expand aria-label="Volledig scherm">{% render 'icon', icon: 'expand' %}</button>
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if featured_media_id == blank and forloop.first
                assign is_active = true
              elsif media.id == featured_media_id
                assign is_active = true
              endif
            -%}
            <div class="gallery__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign img_loading = 'eager'
                    else
                      assign img_loading = 'lazy'
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: img_loading,
                      widths: '550, 800, 1100, 1600',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: media.alt
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1600x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if featured_media_id == blank and forloop.first
                assign is_active = true
              elsif media.id == featured_media_id
                assign is_active = true
              endif
            -%}
            <button
              type="button"
              class="gallery__thumb{% if is_active %} is-active{% endif %}"
              data-thumb-id="{{ media.id }}"
              aria-label="{{ 'accessibility.thumbnail' | t: index: forloop.index }}"
              aria-current="{% if is_active %}true{% else %}false{% endif %}"
            >
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'badges' -%}
            <div class="badges" {{ block.shopify_attributes }}>
              {%- if block.settings.badge_text != blank -%}
                <span class="pill pill--badge">{{ block.settings.badge_text | escape }}</span>
              {%- endif -%}
              {%- if block.settings.show_sale -%}
                {%- assign save = 0 -%}
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  {%- assign save = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
                {%- endif -%}
                <span class="pill pill--sale" data-save-pill{% if save == 0 %} hidden{% endif %}>{{ block.settings.sale_label | default: 'Bespaar' | escape }} <span data-save-value>{{ save }}</span>%</span>
              {%- endif -%}
            </div>

          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="product__vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}
              <h1 class="product__title">{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              {%- assign price_id = 'Price-' | append: section.id -%}
              {% render 'price', product: product, variant: current_variant, price_id: price_id, large: true %}
              <p class="product__tax">
                {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }} {% endif -%}
                {{ 'products.shipping_at_checkout' | t }}
              </p>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              {%- if product.options.size == 1 -%}
                <fieldset class="swatches" {{ block.shopify_attributes }}>
                  <legend class="swatches__legend">{{ block.settings.heading | default: product.options[0] | escape }}</legend>
                  <div class="swatches__grid">
                    {%- for v in product.variants -%}
                      <label class="swatch{% unless v.available %} is-soldout{% endunless %}">
                        <input
                          type="radio"
                          name="Swatch-{{ section.id }}"
                          value="{{ v.id }}"
                          data-variant-radio
                          data-section="{{ section.id }}"
                          {% if v.id == current_variant.id %}checked{% endif %}
                        >
                        <span class="swatch__img">
                          {%- if v.featured_media != blank -%}
                            {{ v.featured_media.preview_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
                          {%- else -%}
                            <span class="swatch__text">{{ v.title | escape }}</span>
                          {%- endif -%}
                        </span>
                        <span class="swatch__label">{{ v.title | escape }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- else -%}
                <div class="field" {{ block.shopify_attributes }}>
                  <label for="VariantSelect-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
                  <select id="VariantSelect-{{ section.id }}" class="select input" data-variant-select data-section="{{ section.id }}">
                    {%- for v in product.variants -%}
                      <option value="{{ v.id }}" {% if v.id == current_variant.id %}selected{% endif %}>
                        {{ v.title | escape }}{% unless v.available %} &ndash; {{ 'products.sold_out' | t }}{% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}
            {%- endunless -%}

          {%- when 'help_card' -%}
            <details class="help-card" {{ block.shopify_attributes }}>
              <summary>
                <span class="help-card__title">{% render 'icon', icon: block.settings.icon %}{{ block.settings.heading | escape }}</span>
                <span class="help-card__action">{{ block.settings.action | escape }}{% render 'icon', icon: 'chevron-down' %}</span>
              </summary>
              <div class="help-card__content rte">{{ block.settings.content }}</div>
            </details>

          {%- when 'stock' -%}
            {%- if block.settings.text != blank -%}
              <p class="stock" data-stock{% unless current_variant.available %} hidden{% endunless %} {{ block.shopify_attributes }}>
                <span class="stock__dot" aria-hidden="true"></span>{{ block.settings.text | escape }}
              </p>
            {%- endif -%}

          {%- when 'quantity' -%}
            {%- comment -%} Aantal zit nu in het blok Koopknoppen. {%- endcomment -%}

          {%- when 'buy_buttons' -%}
            <div class="buy" data-buy {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, class: 'buy-buttons', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id="{{ section.id }}">
                <div class="buy-row">
                  <div class="qty">
                    <button type="button" data-qty-change="-1" aria-label="-">{% render 'icon', icon: 'chevron-left' %}</button>
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                    <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric">
                    <button type="button" data-qty-change="1" aria-label="+">{% render 'icon', icon: 'chevron-right' %}</button>
                  </div>
                  <button
                    id="AddToCart-{{ section.id }}"
                    type="submit"
                    name="add"
                    class="btn btn--full"
                    data-label-add="{{ 'products.add_to_cart' | t }}"
                    data-label-sold-out="{{ 'products.sold_out' | t }}"
                    {% unless current_variant.available %}disabled{% endunless %}
                  >
                    <span data-btn-label>
                      {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
                    </span>
                    <span data-btn-price{% unless current_variant.available %} hidden{% endunless %}>&ndash; {{ current_variant.price | money }}</span>
                  </button>
                </div>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'help_link' -%}
            <a class="help-link" href="{{ block.settings.link | default: routes.root_url }}" {{ block.shopify_attributes }}>
              {% render 'icon', icon: 'help' %}<span>{{ block.settings.text | escape }}</span>
            </a>

          {%- when 'usps' -%}
            <ul class="product-usps" {{ block.shopify_attributes }}>
              {%- if block.settings.usp_1 != blank -%}<li>{% render 'icon', icon: 'truck' %}{{ block.settings.usp_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp_2 != blank -%}<li>{% render 'icon', icon: 'shield' %}{{ block.settings.usp_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp_3 != blank -%}<li>{% render 'icon', icon: 'chat' %}{{ block.settings.usp_3 | escape }}</li>{%- endif -%}
            </ul>

          {%- when 'features' -%}
            <div class="features" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<h2 class="features__title">{{ block.settings.heading | escape }}</h2>{%- endif -%}
              <ul class="features__list">
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign k_title = 'f' | append: i | append: '_title'
                    assign k_text = 'f' | append: i | append: '_text'
                    assign k_icon = 'f' | append: i | append: '_icon'
                  -%}
                  {%- if block.settings[k_title] != blank -%}
                    <li class="feature">
                      {% render 'icon', icon: block.settings[k_icon] %}
                      <strong>{{ block.settings[k_title] | escape }}</strong>
                      <span>{{ block.settings[k_text] | escape }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'collapsible' -%}
            <details class="info-card" {{ block.shopify_attributes }}>
              <summary>
                {%- if block.settings.icon != 'none' -%}{% render 'icon', icon: block.settings.icon %}{%- endif -%}
                <span>{{ block.settings.heading | escape }}</span>
                {% render 'icon', icon: 'plus' %}
              </summary>
              <div class="info-card__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<div class="sticky-atc" data-sticky-atc hidden>
  <div class="container sticky-atc__inner">
    <div class="sticky-atc__info">
      <span class="sticky-atc__title">{{ product.title | escape }}</span>
      <span data-sticky-price>{% render 'price', product: product, variant: current_variant %}</span>
    </div>
    <button type="submit" form="{{ product_form_id }}" name="add" class="btn" {% unless current_variant.available %}disabled{% endunless %}>{{ 'products.add_to_cart' | t }}</button>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Productpagina",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "badges",
      "name": "Labels",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "badge_text", "label": "Label (bruin)", "info": "Bijv. 'Laatste stuks'. Laat leeg om te verbergen.", "default": "" },
        { "type": "checkbox", "id": "show_sale", "label": "Kortingspercentage tonen", "info": "Verschijnt automatisch als de productprijs lager is dan de 'Vergelijk-bij-prijs'.", "default": true },
        { "type": "text", "id": "sale_label", "label": "Tekst voor korting", "default": "Bespaar" }
      ]
    },
    { "type": "title", "name": "Titel", "limit": 1, "settings": [ { "type": "checkbox", "id": "show_vendor", "label": "Merk tonen", "default": false } ] },
    { "type": "price", "name": "Prijs", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Uitvoering kiezen",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel boven opties", "info": "Laat leeg om de naam van de optie te gebruiken (bijv. Kleur).", "default": "Opties" }
      ]
    },
    {
      "type": "help_card",
      "name": "Uitklapkaart (gekleurd)",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "palette", "label": "Materialen" }, { "value": "info", "label": "Info" }, { "value": "help", "label": "Hulp" }, { "value": "box", "label": "Pakket" } ], "default": "palette" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Twijfel je over de kleur?" },
        { "type": "text", "id": "action", "label": "Tekst rechts", "default": "Vraag stalen aan" },
        { "type": "richtext", "id": "content", "label": "Inhoud", "default": "<p>Wil je de kleur eerst zien? Neem contact met ons op.</p>" }
      ]
    },
    {
      "type": "stock",
      "name": "Voorraadstatus",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst (groen)", "info": "Verdwijnt automatisch als de gekozen uitvoering uitverkocht is.", "default": "Op voorraad" }
      ]
    },
    { "type": "quantity", "name": "Aantal (oud)", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Aantal en koopknop",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Snelle betaalknoppen tonen", "info": "Bijv. Apple Pay of Shop Pay, afhankelijk van je betaalinstellingen.", "default": false }
      ]
    },
    {
      "type": "help_link",
      "name": "Hulplink",
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst", "default": "Hulp nodig? Neem contact op" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "usps",
      "name": "Voordelen",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "usp_1", "label": "Voordeel 1", "default": "Levering in België en Nederland" },
        { "type": "text", "id": "usp_2", "label": "Voordeel 2", "default": "Veilig betalen" },
        { "type": "text", "id": "usp_3", "label": "Voordeel 3", "default": "Persoonlijk advies voor je studio" }
      ]
    },
    {
      "type": "features",
      "name": "Kenmerken (kaartjes)",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Kenmerken" },
        { "type": "select", "id": "f1_icon", "label": "Icoon 1", "options": [ { "value": "ruler", "label": "Afmeting" }, { "value": "sparkle", "label": "Beauty" }, { "value": "star", "label": "Kwaliteit" }, { "value": "shield", "label": "Garantie" }, { "value": "box", "label": "Pakket" }, { "value": "check", "label": "Vinkje" }, { "value": "truck", "label": "Levering" }, { "value": "tag", "label": "Prijs" } ], "default": "ruler" },
        { "type": "text", "id": "f1_title", "label": "Titel 1", "default": "185 cm" },
        { "type": "text", "id": "f1_text", "label": "Tekst 1", "default": "Lengte van het bed" },
        { "type": "select", "id": "f2_icon", "label": "Icoon 2", "options": [ { "value": "ruler", "label": "Afmeting" }, { "value": "sparkle", "label": "Beauty" }, { "value": "star", "label": "Kwaliteit" }, { "value": "shield", "label": "Garantie" }, { "value": "box", "label": "Pakket" }, { "value": "check", "label": "Vinkje" }, { "value": "truck", "label": "Levering" }, { "value": "tag", "label": "Prijs" } ], "default": "sparkle" },
        { "type": "text", "id": "f2_title", "label": "Titel 2", "default": "5 standen" },
        { "type": "text", "id": "f2_text", "label": "Tekst 2", "default": "Verstelbare hoofdsteun" },
        { "type": "select", "id": "f3_icon", "label": "Icoon 3", "options": [ { "value": "ruler", "label": "Afmeting" }, { "value": "sparkle", "label": "Beauty" }, { "value": "star", "label": "Kwaliteit" }, { "value": "shield", "label": "Garantie" }, { "value": "box", "label": "Pakket" }, { "value": "check", "label": "Vinkje" }, { "value": "truck", "label": "Levering" }, { "value": "tag", "label": "Prijs" } ], "default": "star" },
        { "type": "text", "id": "f3_title", "label": "Titel 3", "default": "Hoogwaardig" },
        { "type": "text", "id": "f3_text", "label": "Tekst 3", "default": "Kunstleer, makkelijk te reinigen" },
        { "type": "select", "id": "f4_icon", "label": "Icoon 4", "options": [ { "value": "ruler", "label": "Afmeting" }, { "value": "sparkle", "label": "Beauty" }, { "value": "star", "label": "Kwaliteit" }, { "value": "shield", "label": "Garantie" }, { "value": "box", "label": "Pakket" }, { "value": "check", "label": "Vinkje" }, { "value": "truck", "label": "Levering" }, { "value": "tag", "label": "Prijs" } ], "default": "shield" },
        { "type": "text", "id": "f4_title", "label": "Titel 4", "default": "Garantie" },
        { "type": "text", "id": "f4_text", "label": "Tekst 4", "default": "Op constructie" }
      ]
    },
    { "type": "description", "name": "Beschrijving", "limit": 1 },
    { "type": "text", "name": "Tekst", "settings": [ { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Extra tekst</p>" } ] },
    {
      "type": "collapsible",
      "name": "Uitklapblok",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [ { "value": "none", "label": "Geen" }, { "value": "truck", "label": "Levering" }, { "value": "box", "label": "Pakket" }, { "value": "shield", "label": "Garantie" }, { "value": "return", "label": "Retour" }, { "value": "info", "label": "Info" }, { "value": "trophy", "label": "Uniek" }, { "value": "clipboard", "label": "Specificaties" }, { "value": "palette", "label": "Materialen" }, { "value": "users", "label": "Personalisatie" }, { "value": "chat", "label": "Service" } ], "default": "truck" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Levering & retour" },
        { "type": "richtext", "id": "content", "label": "Inhoud" },
        { "type": "page", "id": "page", "label": "Inhoud van pagina (optioneel)" }
      ]
    }
  ]
}
{% endschema %}
