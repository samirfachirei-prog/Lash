{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign featured_media_id = current_variant.featured_media.id | default: product.featured_media.id
-%}

<script type="application/json" id="ProductVariants-{{ section.id }}">
  [
    {%- for v in product.variants -%}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "available": {{ v.available | json }},
        "price": {{ v.price | money | json }},
        "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
        "media": {% if v.featured_media %}{{ v.featured_media.id | json }}{% else %}null{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
</script>

<section class="section section--tight">
  <div class="container product">
    <div class="product__media" data-gallery="{{ section.id }}">
      <div class="gallery__main">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if featured_media_id == blank and forloop.first
                assign is_active = true
              elsif media.id == featured_media_id
                assign is_active = true
              endif
            -%}
            <div class="gallery__slide{% if is_active %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign img_loading = 'eager'
                    else
                      assign img_loading = 'lazy'
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1600
                    | image_tag:
                      loading: img_loading,
                      widths: '550, 800, 1100, 1600',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: media.alt
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1600x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="gallery__thumbs">
          {%- for media in product.media -%}
            {%- liquid
              assign is_active = false
              if featured_media_id == blank and forloop.first
                assign is_active = true
              elsif media.id == featured_media_id
                assign is_active = true
              endif
            -%}
            <button
              type="button"
              class="gallery__thumb{% if is_active %} is-active{% endif %}"
              data-thumb-id="{{ media.id }}"
              aria-label="{{ 'accessibility.thumbnail' | t: index: forloop.index }}"
              aria-current="{% if is_active %}true{% else %}false{% endif %}"
            >
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.show_vendor and product.vendor != blank -%}
                <p class="product__vendor">{{ product.vendor | escape }}</p>
              {%- endif -%}
              <h1 class="product__title h2">{{ product.title | escape }}</h1>
            </div>

          {%- when 'price' -%}
            <div {{ block.shopify_attributes }}>
              {%- assign price_id = 'Price-' | append: section.id -%}
              {% render 'price', product: product, variant: current_variant, price_id: price_id, large: true %}
              <p class="product__tax">
                {%- if cart.taxes_included -%}{{ 'products.tax_included' | t }} {% endif -%}
                {{ 'products.shipping_at_checkout' | t }}
              </p>
            </div>

          {%- when 'variant_picker' -%}
            {%- unless product.has_only_default_variant -%}
              <div class="field" {{ block.shopify_attributes }}>
                <label for="VariantSelect-{{ section.id }}">{{ product.options | join: ' / ' }}</label>
                <select
                  id="VariantSelect-{{ section.id }}"
                  class="select input"
                  data-variant-select
                  data-section="{{ section.id }}"
                >
                  {%- for v in product.variants -%}
                    <option
                      value="{{ v.id }}"
                      {% if v.id == current_variant.id %}selected{% endif %}
                    >
                      {{ v.title | escape }}{% unless v.available %} &ndash; {{ 'products.sold_out' | t }}{% endunless %}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endunless -%}

          {%- when 'quantity' -%}
            <div class="field" {{ block.shopify_attributes }}>
              <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <div>
                <div class="qty">
                  <button type="button" data-qty-change="-1" aria-label="-">&minus;</button>
                  <input
                    id="Quantity-{{ section.id }}"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    form="{{ product_form_id }}"
                  >
                  <button type="button" data-qty-change="1" aria-label="+">+</button>
                </div>
              </div>
            </div>

          {%- when 'buy_buttons' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: product_form_id, class: 'buy-buttons', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id="{{ section.id }}">
                <button
                  id="AddToCart-{{ section.id }}"
                  type="submit"
                  name="add"
                  class="btn btn--full"
                  data-label-add="{{ 'products.add_to_cart' | t }}"
                  data-label-sold-out="{{ 'products.sold_out' | t }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {%- if current_variant.available -%}
                    {{ 'products.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>
                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'usps' -%}
            <ul class="product-usps" {{ block.shopify_attributes }}>
              {%- if block.settings.usp_1 != blank -%}<li>{% render 'icon', icon: 'truck' %}{{ block.settings.usp_1 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp_2 != blank -%}<li>{% render 'icon', icon: 'shield' %}{{ block.settings.usp_2 | escape }}</li>{%- endif -%}
              {%- if block.settings.usp_3 != blank -%}<li>{% render 'icon', icon: 'chat' %}{{ block.settings.usp_3 | escape }}</li>{%- endif -%}
            </ul>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="rte" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'text' -%}
            <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'collapsible' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading | escape }}{% render 'icon', icon: 'plus' %}</summary>
              <div class="accordion__content rte">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}
                  {{ block.settings.page.content }}
                {%- endif -%}
              </div>
            </details>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_media -%}
      "image": [{{ product.featured_media | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | json }},
    "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
    "offers": [
      {%- for v in product.variants -%}
        {
          "@type": "Offer",
          {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ v.price | divided_by: 100.00 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: v.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Productpagina",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Titel",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_vendor", "label": "Merk tonen", "default": false }
      ]
    },
    { "type": "price", "name": "Prijs", "limit": 1 },
    { "type": "variant_picker", "name": "Uitvoering kiezen", "limit": 1 },
    { "type": "quantity", "name": "Aantal", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Koopknoppen",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Snelle betaalknoppen tonen",
          "info": "Bijv. Apple Pay of Shop Pay, afhankelijk van je betaalinstellingen.",
          "default": true
        }
      ]
    },
    {
      "type": "usps",
      "name": "Voordelen",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "usp_1", "label": "Voordeel 1", "default": "Levering in België en Nederland" },
        { "type": "text", "id": "usp_2", "label": "Voordeel 2", "default": "Veilig betalen" },
        { "type": "text", "id": "usp_3", "label": "Voordeel 3", "default": "Persoonlijk advies voor je studio" }
      ]
    },
    { "type": "description", "name": "Beschrijving", "limit": 1 },
    {
      "type": "text",
      "name": "Tekst",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Extra tekst</p>" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Uitklapblok",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Levering & retour" },
        { "type": "richtext", "id": "content", "label": "Inhoud" },
        { "type": "page", "id": "page", "label": "Inhoud van pagina (optioneel)" }
      ]
    }
  ]
}
{% endschema %}
