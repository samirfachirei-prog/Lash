{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
<section class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="container">
    <div class="section-header">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if col != blank -%}
        <a class="link-arrow" href="{{ col.url }}">{{ 'collections.view_all' | t }}</a>
      {%- endif -%}
    </div>
    <div class="grid grid--{{ section.settings.columns }}">
      {%- if col != blank and col.products_count > 0 -%}
        {%- for product in col.products limit: limit -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'product-card', card_product: blank, placeholder_index: i %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Uitgelichte producten",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine titel", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Favoriet bij lash artists" },
    { "type": "collection", "id": "collection", "label": "Collectie" },
    { "type": "range", "id": "products_to_show", "label": "Aantal producten", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Kolommen op desktop", "min": 3, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "surface", "label": "Gekleurde achtergrond", "default": false }
  ],
  "presets": [{ "name": "Uitgelichte producten" }]
}
{% endschema %}
