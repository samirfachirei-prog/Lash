<div class="password-box">
  <h1>{{ shop.name }}</h1>
  <p class="eyebrow">{{ 'password.opening_soon' | t }}</p>
  {%- if shop.password_message != blank -%}
    <p class="muted">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- if section.settings.show_newsletter -%}
    {%- form 'customer', id: 'PasswordNewsletter' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      {%- if form.posted_successfully? -%}
        <p class="form-message">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label class="visually-hidden" for="PasswordNewsletterEmail">{{ 'newsletter.email' | t }}</label>
          <input id="PasswordNewsletterEmail" class="input" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
          <button class="btn" type="submit">{{ 'newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  <details style="margin-top: 3rem;">
    <summary class="muted" style="cursor:pointer;">{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error" style="margin-top:1rem;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="newsletter__form">
        <label class="visually-hidden" for="StorePassword">{{ 'password.enter_password' | t }}</label>
        <input id="StorePassword" class="input" type="password" name="password" placeholder="{{ 'password.enter_password' | t }}" autocomplete="current-password">
        <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Wachtwoordpagina",
  "class": "section-main-password",
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "Inschrijfformulier tonen", "default": true }
  ]
}
{% endschema %}
