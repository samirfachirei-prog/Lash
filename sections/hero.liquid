{%- liquid
  assign s = section.settings
  assign overlay = s.overlay_opacity | divided_by: 100.0
-%}
<section
  class="hero hero--{{ s.height }}{% if s.alignment == 'center' %} hero--center{% endif %}{% if s.image_mobile != blank %} hero--has-mobile{% endif %}"
>
  <div class="hero__media">
    {%- if s.image != blank -%}
      {{
        s.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 1800, 2400',
          sizes: '100vw',
          class: 'hero__desktop-image',
          alt: s.image.alt
      }}
      {%- if s.image_mobile != blank -%}
        {{
          s.image_mobile
          | image_url: width: 1100
          | image_tag:
            loading: 'eager',
            widths: '550, 750, 1100',
            sizes: '100vw',
            class: 'hero__mobile-image',
            alt: s.image_mobile.alt
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="hero__overlay" style="opacity: {{ overlay }};"></div>
  <div class="hero__content">
    <div class="container">
      <div class="hero__text">
        {%- if s.eyebrow != blank -%}
          <span class="eyebrow">{{ s.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h1>{{ s.heading | escape }}</h1>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="rte">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button_label_2 != blank -%}
          <div class="hero__buttons">
            {%- if s.button_label != blank -%}
              <a class="btn btn--light" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
            {%- endif -%}
            {%- if s.button_label_2 != blank -%}
              <a class="btn btn--outline" href="{{ s.button_link_2 | default: routes.collections_url }}">{{ s.button_label_2 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero banner",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Afbeelding" },
    { "type": "image_picker", "id": "image_mobile", "label": "Afbeelding mobiel (optioneel)" },
    {
      "type": "select",
      "id": "height",
      "label": "Hoogte",
      "options": [
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Middel" },
        { "value": "large", "label": "Groot" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Uitlijning tekst",
      "options": [
        { "value": "left", "label": "Links" },
        { "value": "center", "label": "Midden" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Donkere overlay", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "text", "id": "eyebrow", "label": "Kleine titel", "default": "Voor lash artists" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Alles voor jouw lash studio" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>Lash beds, zadelstoelen, lampen en spiegels, geselecteerd op comfort, kwaliteit en uitstraling.</p>" },
    { "type": "text", "id": "button_label", "label": "Knop 1 tekst", "default": "Shop lash beds" },
    { "type": "url", "id": "button_link", "label": "Knop 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Knop 2 tekst", "default": "Alle categorieën" },
    { "type": "url", "id": "button_link_2", "label": "Knop 2 link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
