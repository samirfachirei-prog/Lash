<section class="section">
  <div class="container customer">
    <h1>{{ 'customer.reset_title' | t }}</h1>
    <p class="text-center muted">{{ 'customer.reset_text' | t }}</p>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form-message form-message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="field">
        <label for="ResetPassword">{{ 'customer.password' | t }}</label>
        <input id="ResetPassword" class="input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label>
        <input id="ResetPasswordConfirm" class="input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="btn" type="submit">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Wachtwoord herstellen",
  "class": "section-main-reset-password",
  "settings": []
}
{% endschema %}
