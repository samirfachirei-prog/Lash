<section class="section section--tight">
  <div class="container">
    <h1 class="text-center">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label for="SearchInput" class="visually-hidden">{{ 'search.placeholder' | t }}</label>
      <input id="SearchInput" class="input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <input type="hidden" name="options[prefix]" value="last">
      <button class="btn" type="submit">{{ 'search.submit' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count > 0 -%}
          <p class="text-center muted">{{ 'search.results' | t: count: search.results_count, terms: search.terms }}</p>
          <div class="grid grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <div class="search-result-plain">
                  <h3 class="card__title"><a href="{{ item.url }}">{{ item.title | escape }}</a></h3>
                  <p class="muted">{{ item.content | strip_html | truncatewords: 20 }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <p class="text-center muted">{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zoekresultaten",
  "class": "section-main-search",
  "settings": []
}
{% endschema %}
